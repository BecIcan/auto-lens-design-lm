# 私有生成器只在服务端加载
EADLD_BACKEND_FACTORY=private.seed_backend:create_backend
EADLD_BACKEND_CONFIG=

# 留空即为免登录体验；如需内部演示，可设置至少 32 字节的访问码
EADLD_ACCESS_TOKEN=
EADLD_PUBLIC_ORIGIN=http://127.0.0.1:8000
EADLD_ALLOWED_HOSTS=127.0.0.1,localhost

EADLD_RESULT_ROOT=outputs/web-results
EADLD_RESULT_TTL_SECONDS=1800
EADLD_RATE_LIMIT=3
EADLD_DAILY_LIMIT=5
EADLD_QUOTA_DATABASE=outputs/web-quota.sqlite3
# 生产环境使用随机生成的长密钥，不能提交到仓库
EADLD_QUOTA_SECRET=replace-with-a-long-random-secret
EADLD_MAX_CONCURRENT=1
EADLD_GENERATION_TIMEOUT_SECONDS=180
EADLD_MAX_BODY_BYTES=16384
# Cloudflare Tunnel 下设为 cf-connecting-ip；本机直连时留空
EADLD_CLIENT_IP_HEADER=
