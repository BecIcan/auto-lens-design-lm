# 私有生成器只在服务端加载
EADLD_BACKEND_FACTORY=private_seed.runtime:create_backend
EADLD_BACKEND_CONFIG=D:\private\seed.json

# 至少 32 字节随机访问码；生产环境只通过 HTTPS 使用
EADLD_ACCESS_TOKEN=replace-with-a-long-random-token
EADLD_PUBLIC_ORIGIN=http://127.0.0.1:8000
EADLD_ALLOWED_HOSTS=127.0.0.1,localhost

EADLD_RESULT_ROOT=outputs/web-results
EADLD_RESULT_TTL_SECONDS=1800
EADLD_RATE_LIMIT=3
EADLD_MAX_CONCURRENT=1
EADLD_GENERATION_TIMEOUT_SECONDS=180
EADLD_MAX_BODY_BYTES=16384
EADLD_TRUST_PROXY_HEADERS=0
